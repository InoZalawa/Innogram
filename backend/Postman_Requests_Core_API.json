{
  "info": {
    "name": "Core Microservice API",
    "description": "Postman collection for Core Microservice (NestJS) endpoints - Innogram",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshTokenId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3003",
          "path": [""]
        }
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"repeatPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshTokenId\": \"{{refreshTokenId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "OAuth Login - Google",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login/google",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["auth", "login", "google"]
            }
          }
        },
        {
          "name": "OAuth Callback - Google",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback?code=auth_code_here",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["auth", "google", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "auth_code_here"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshTokenId\": \"{{refreshTokenId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/current_user",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["users", "current_user"]
            }
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profiles/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["profiles", "me"]
            }
          }
        }
      ]
    }
  ]
}
