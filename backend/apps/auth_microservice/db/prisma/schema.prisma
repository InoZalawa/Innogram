datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./prisma"
}

// 3. Modele
model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique
  password      String
  refreshTokens RefreshToken[]
}

model RefreshToken {
  token  String @id
  userId Int
  user   User   @relation(fields: [userId], references: [id])
}
