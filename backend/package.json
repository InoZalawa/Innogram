{
  "name": "@intern-project/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "ts-node-dev -r tsconfig-paths/register --project tsconfig.json --respawn --transpile-only --poll --ignore-watch node_modules --ignore-watch .git --ignore-watch dist --clear apps/auth_microservice/app.ts",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "check-format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "docker:up": "docker-compose up --build",
    "docker:up:detached": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:backend": "docker-compose logs -f backend",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:logs:redis": "docker-compose logs -f redis",
    "docker:ps": "docker-compose ps",
    "docker:restart": "docker-compose restart",
    "docker:stop": "docker-compose stop",
    "docker:start": "docker-compose start",
    "docker:clean": "docker-compose down -v",
    "docker:rebuild": "docker-compose build --no-cache backend && docker-compose up -d"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nx/js": "22.0.4",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.11",
    "nx": "22.0.4",
    "prettier": "^2.6.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.47.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.0.1",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prisma": "^7.1.0",
    "redis": "^5.10.0",
    "ts-node": "^10.9.2",
    "winston": "^3.15.0"
  }
}
